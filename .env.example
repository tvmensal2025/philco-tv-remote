# ================================================================
# REELOPS — copie para .env e substitua todos os valores CHANGE_ME
# Nunca envie o arquivo .env ao GitHub.
# ================================================================

# SUPABASE — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# SUPABASE — Database > Connect > Direct connection
# Necessária somente pelo container de migrations.
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres?sslmode=require

# MINIO EXISTENTE NA VPS
# Use apenas o hostname, sem http:// e sem barra final.
# Se o MinIO estiver no host da VPS, use host.docker.internal.
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=restaurant-media

# URL pública do MinIO — opcional, necessária apenas para Instagram.
# Deve ser acessível pela internet e ter HTTPS válido.
MINIO_PUBLIC_ENDPOINT=media.seudominio.com
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_SSL=true

# FILA
REDIS_URL=redis://redis:6379

# APLICAÇÃO
APP_URL=https://reels.seudominio.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Gere com: npm run key:generate
INGEST_API_KEY=CHANGE_ME_RANDOM_KEY_WITH_AT_LEAST_24_CHARACTERS
# Limite de segurança por segmento (padrão: 256 MiB)
MAX_SEGMENT_BYTES=268435456

# CAPTURA E PROCESSAMENTO
MOMENT_WINDOW_BEFORE_SECONDS=12
MOMENT_WINDOW_AFTER_SECONDS=8
NVR_SEGMENT_SECONDS=60
RAW_RETENTION_DAYS=7
WORKER_CONCURRENCY=1
WORK_DIR=/tmp/reelops
FFMPEG_PRESET=veryfast
LOG_LEVEL=info

# INSTAGRAM PROFISSIONAL — opcional
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v23.0
