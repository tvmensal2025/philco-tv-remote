# ================================================================
# REELOPS — copie para .env e substitua todos os valores CHANGE_ME
# Nunca envie o arquivo .env ao GitHub.
# ================================================================

# SUPABASE — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# SUPABASE — Database > Connect > Direct connection
# Necessária somente pelo container de migrations.
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres?sslmode=require

# MINIO exclusivo do CENAPRONTA (projeto EasyPanel cenapronta).
# API S3: https://cenapronta-minio.d9v63q.easypanel.host
# Aceita também MINIO_SERVER_URL / MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
MINIO_SERVER_URL=https://cenapronta-minio.d9v63q.easypanel.host
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=cenapronta-minio.d9v63q.easypanel.host
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=cenapronta

# URL pública S3 do mesmo MinIO (WhatsApp/Instagram baixam daqui).
MINIO_PUBLIC_ENDPOINT=cenapronta-minio.d9v63q.easypanel.host
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_SSL=true

# FILA — Redis EasyPanel: projeto cenapronta, serviço cenaforte.
# Na mesma network dos containers: redis://cenaforte:6379
# Se o Redis tiver senha: redis://:SENHA@cenaforte:6379
REDIS_URL=redis://cenaforte:6379

# Login por e-mail (magic link).
# Desenvolvimento: AUTH_BYPASS=true precisa ser explícito.
# Produção: AUTH_BYPASS fica false. Só ligue com ALLOW_AUTH_BYPASS_IN_PRODUCTION=true em emergência.
AUTH_BYPASS=true
# ALLOW_AUTH_BYPASS_IN_PRODUCTION=false

# Administrador da plataforma (você). Separado do owner do restaurante.
# Lista de e-mails, vírgula. Só esses abrem /admin. Com AUTH_BYPASS, o painel abre em desenvolvimento.
PLATFORM_ADMIN_EMAILS=


# APLICAÇÃO
# Em produção use HTTPS. O WhatsApp baixa os 3 Reels por /api/public/reels/...
APP_URL=https://reels.seudominio.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Gere com: npm run key:generate
INGEST_API_KEY=CHANGE_ME_RANDOM_KEY_WITH_AT_LEAST_24_CHARACTERS
# Limite de segurança por segmento (padrão: 256 MiB)
MAX_SEGMENT_BYTES=268435456

# CAPTURA E PROCESSAMENTO
MOMENT_WINDOW_BEFORE_SECONDS=12
MOMENT_WINDOW_AFTER_SECONDS=8
NVR_SEGMENT_SECONDS=60
RAW_RETENTION_DAYS=7
VIDEO_WORKER_CONCURRENCY=1
RENDER_WORKER_CONCURRENCY=1
INDEX_WORKER_CONCURRENCY=2
HIGHLIGHT_WORKER_CONCURRENCY=1
WORKER_CONCURRENCY=1
WORK_DIR=/tmp/reelops
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=2
# Caminho absoluto do FFmpeg/ffprobe com lavfi (Gyan/full). O binário bundled do Revideo não tem lavfi.
FFMPEG_PATH=
FFPROBE_PATH=
RENDER_PROFILE=standard
VISION_MAX_FRAMES=4
LOG_LEVEL=info

# IA — opcional. Sem chave o worker usa scores locais de cena/áudio.
# OpenAI e Gemini recebem somente JPEGs/clips curtos, nunca as horas brutas do NVR.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VISION_PROVIDER=auto
VISION_PROVIDER_PRIMARY=auto
VISION_PROVIDER_SECONDARY=gemini
REQUIRE_REAL_VISION=true

# YOLO — recorte 9:16 (pessoa/prato). Mesmo projeto EasyPanel, serviço `yolo`.
# Sem YOLO_URL o worker corta no centro, como hoje. Sem GPU. Clipe típico: 20s.
# No EasyPanel (worker): YOLO_URL=http://yolo:8000
YOLO_URL=
YOLO_API_KEY=
YOLO_TIMEOUT_MS=15000
ALLOW_STORAGE_SCAN_FALLBACK=false
HIGHLIGHT_DAILY_CAP=24
HIGHLIGHT_MIN_SCORE=58

# Pipeline V2 — defaults seguros. Revideo/ElevenLabs/Visual QC/Auto Repair ficam desligados
# até um render real passar. Não ligue ENABLE_REVIDEO em produção sem canary no restaurante
# (restaurants.settings.enableRevideo=true).
VIDEO_PIPELINE_VERSION=2.0
ENABLE_REVIDEO=false
ENABLE_AI_DIRECTOR=false
REQUIRE_AI_DIRECTOR=false
REQUIRE_REVIDEO_RENDER=false
ENABLE_MULTICAMERA_RANKER=false
ENABLE_YOLO=false
ENABLE_TRACKING=false
ENABLE_SMART_REFRAME=false
ENABLE_BEAT_EDITING=false
ENABLE_VISUAL_QC=false
ENABLE_TRACKING_QC=false
ENABLE_AUTO_REPAIR=false
ENABLE_ELEVENLABS=false
# TTS no worker: POST https://api.elevenlabs.io/v1/text-to-speech/{voice_id}
# Precisa dos três: flag + chave + voice id. Sem isso o Reel segue com áudio original.
# Modelo multilingual para PT-BR. Narração = título/legenda (máx. 180 caracteres).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_MS=45000
STALE_JOB_MS=600000
MAX_JOB_RECOVERIES=2
QC_MIN_VISUAL_SCORE=0
QC_MIN_BRAND_SCORE=0
QC_MIN_STORY_SCORE=0
MAX_AUTO_REPAIR_ATTEMPTS=1
FFMPEG_HWACCEL=none

# INSTAGRAM PROFISSIONAL — opcional
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v23.0

# WHATSAPP DIÁRIO — mesma instância WAME do iGreen e do Mandato.
# POST {WAME_SERVER}/{WAME_API_KEY}/message/video
# Pode repetir WAME_API_KEY_RITA (nome usado no Mandato).
WAME_SERVER=https://us.api-wa.me
WAME_API_KEY=
WAME_API_KEY_RITA=
CRON_SECRET=
